PORT=3000
NODE_ENV=development
POSTGRES_DB=db-convey
# PostgreSQL 18 connection URL
DATABASE_URL=postgres://convey:convey@localhost:5432/db-convey
# DragonflyDB / Redis-compatible in-memory store connection URL
REDIS_URL=redis://localhost:6379
LOG_LEVEL=info
BULLMQ_SCHEDULING_HORIZON_SECONDS=1800

# ------------------------------------------------------------------------------
# ⚡ MOCK PROVIDER CONFIGURATION (For local & production Docker tests)
# ------------------------------------------------------------------------------
MOCK_GATEWAY_PORT=4000
WEBHOOK_URL=http://localhost:3000/v1/webhooks/providers
WEBHOOK_DELAY_MS=400
CHAOS_LATENCY_MS=0
CHAOS_ERROR_RATE=0

# Mock Provider Credentials (Pre-configured for mock containers)
RESEND_API_KEY=re_mock_prod_key_1234567890
RESEND_FROM_EMAIL=onboarding@convey.dev
SENDGRID_API_KEY=SG.mock_sendgrid_key_1234567890
SENDGRID_FROM_EMAIL=notifications@convey.dev
TWILIO_ACCOUNT_SID=ACmockaccount1234567890abcdef
TWILIO_AUTH_TOKEN=mock_twilio_auth_token_secret
TWILIO_FROM_NUMBER=+15550192834
SLACK_BOT_TOKEN=xoxb-mock-slack-bot-token-12345
SLACK_DEFAULT_CHANNEL=general
PAGERDUTY_ROUTING_KEY=mock_pagerduty_routing_key_123
