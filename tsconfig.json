{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["bun", "node"],
    "paths": {
      "@convey/shared": ["./packages/shared/src/index.ts"]
    }
  },
  "references": [{ "path": "./packages/shared" }, { "path": "./apps/server" }, { "path": "./apps/web" }],
  "files": []
}
