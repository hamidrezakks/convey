{
  "name": "@convey/sdk",
  "version": "1.0.0",
  "description": "Official zero-dependency Node.js, Bun, and Edge SDK for the Convey communication service",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "keywords": [
    "convey",
    "sdk",
    "communication",
    "email",
    "sms",
    "whatsapp",
    "push",
    "slack",
    "messaging",
    "resilience",
    "idempotency"
  ],
  "author": "Convey",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamidrezakks/convey.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/hamidrezakks/convey/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/hamidrezakks/convey/issues"
  }
}
