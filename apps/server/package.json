{
  "name": "@convey/server",
  "version": "1.0.0",
  "description": "High-performance, resilient multi-tenant communication service backend",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamidrezakks/convey.git",
    "directory": "apps/server"
  },
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "test:e2e": "bun test tests/e2e",
    "test:bench": "bun test tests/e2e/bench.test.ts",
    "test:stress": "bun test tests/planetary-stress.test.ts",
    "bench": "bun run bench/index.ts",
    "bench:api": "bun run bench/index.ts --api",
    "bench:engine": "bun run bench/index.ts --engine",
    "bench:pipeline": "bun run bench/index.ts --pipeline",
    "bench:stress": "bun run bench/index.ts --stress",
    "bench:all": "bun run bench/index.ts --all",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:seed:million": "bun scripts/seed-production-million.ts",
    "jobs:dump": "bun scripts/get-job-consumption.ts",
    "benchmark:report": "bun scripts/benchmark-report.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.749.0",
    "@convey/shared": "workspace:*",
    "@elysia/cors": "2.0.0-beta.1",
    "@elysia/openapi": "2.0.0-beta.1",
    "@sendgrid/mail": "^8.1.4",
    "@sinclair/typebox": "0.34.52",
    "@slack/web-api": "^7.8.0",
    "bullmq": "^6.1.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "elysia": "2.0.0-beta.6",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "twilio": "^5.4.3",
    "typebox": "1.3.16",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/bun": "latest",
    "drizzle-kit": "^1.0.0-rc.4"
  }
}
