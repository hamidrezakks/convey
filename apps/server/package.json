{
  "name": "@convey/server",
  "version": "1.0.0",
  "description": "High-performance, resilient multi-tenant communication service backend",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "test:e2e": "bun test tests/e2e",
    "test:bench": "bun test tests/e2e/bench.test.ts",
    "bench": "bun run bench/index.ts",
    "bench:api": "bun run bench/index.ts --api",
    "bench:engine": "bun run bench/index.ts --engine",
    "bench:pipeline": "bun run bench/index.ts --pipeline",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "jobs:dump": "bun scripts/get-job-consumption.ts",
    "benchmark:report": "bun scripts/benchmark-report.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.749.0",
    "@convey/shared": "workspace:*",
    "@elysiajs/cors": "1.0.0-beta.2",
    "@elysiajs/swagger": "1.0.0-beta.2",
    "@sendgrid/mail": "^8.1.4",
    "@sinclair/typebox": "0.34.52",
    "@slack/web-api": "^7.8.0",
    "bullmq": "^6.1.2",
    "drizzle-orm": "^1.0.0-beta.22",
    "elysia": "next",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "twilio": "^5.4.3",
    "zod": "^4.4.3"
  },

  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/bun": "latest",
    "drizzle-kit": "^1.0.0-beta.22"
  }
}
