{
  "name": "convey-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "High-performance, resilient multi-tenant communication service monorepo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamidrezakks/convey.git"
  },
  "homepage": "https://github.com/hamidrezakks/convey#readme",
  "bugs": {
    "url": "https://github.com/hamidrezakks/convey/issues"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' dev",
    "dev:server": "bun --filter @convey/server dev",
    "dev:plugins": "bun --filter @convey/plugins dev",
    "dev:web": "bun --filter @convey/web dev",
    "dev:website": "bun --filter @convey/website dev",
    "mock:dev": "bun apps/mock-server/src/index.ts",
    "mock:test": "bun test apps/mock-server",
    "docker:providers:up": "docker compose -f docker-compose.yml -f docker-compose.providers.yml up -d",
    "docker:providers:down": "docker compose -f docker-compose.yml -f docker-compose.providers.yml down",
    "start": "bun --filter @convey/server start",
    "build": "bun --filter '*' build",
    "build:sdk": "bun --filter @convey/sdk build",
    "build:website": "bun --filter @convey/website build",
    "release:bump": "bun scripts/release-bump.ts",
    "test": "bun --filter @convey/server test",
    "test:plugins": "bun --filter @convey/plugins test",
    "test:web": "bun --filter @convey/web test",
    "test:mock": "bun test apps/mock-server",
    "test:sdk": "bun scripts/test-sdk-unit.ts",
    "test:go": "cd packages/sdk-go && go test -v -race ./...",
    "test:py": "PYTHONPATH=packages/sdk-py python3 -m unittest discover -s packages/sdk-py/tests -v",
    "test:sdks": "bun run test:sdk && bun run test:go && bun run test:py",
    "test:e2e:sdks": "bun run scripts/run-e2e-sdks.ts",
    "test:prod:docker": "bun scripts/run-production-docker-test.ts",
    "test:prod:soak": "bun scripts/run-all-providers-soak-test.ts",
    "test:all": "bun test",
    "test:e2e": "bun --filter @convey/server test:e2e",
    "test:bench": "bun --filter @convey/server test:bench",
    "test:stress": "bun --filter @convey/server test:stress",
    "bench": "bun --filter @convey/server bench",
    "bench:api": "bun --filter @convey/server bench:api",
    "bench:engine": "bun --filter @convey/server bench:engine",
    "bench:pipeline": "bun --filter @convey/server bench:pipeline",
    "bench:stress": "bun --filter @convey/server bench:stress",
    "bench:all": "bun --filter @convey/server bench:all",
    "biome:check": "biome check .",
    "biome:format": "biome format --write .",
    "biome:lint": "biome lint .",
    "db:check": "bun --filter @convey/server db:check",
    "db:migrate": "bun --filter @convey/server db:migrate",
    "db:seed:million": "bun --filter @convey/server db:seed:million",
    "typecheck": "bun --filter @convey/website generate && bunx tsc --noEmit -p apps/server/tsconfig.json && bunx tsc --noEmit -p apps/web/tsconfig.json && bunx tsc --noEmit -p apps/website/tsconfig.json && bunx tsc --noEmit -p apps/plugins/tsconfig.json && bunx tsc --noEmit -p packages/shared/tsconfig.json && bunx tsc --noEmit -p packages/sdk/tsconfig.json",
    "postinstall": "bun scripts/patch-openapi.ts",
    "test:server:ci": "bun scripts/test-server-ci.ts",
    "test:server:performance": "bun scripts/test-server-ci.ts --performance",
    "qualification:inventory": "bun scripts/qualification/provider-inventory.ts",
    "qualification:inventory:check": "bun scripts/qualification/provider-inventory.ts --check",
    "qualification:recovery": "bun scripts/qualification/recovery.ts",
    "qualification:artifacts": "bun scripts/qualification/sdk-artifacts.ts",
    "qualification:python": "python3 scripts/qualification/python-artifact.py",
    "qualification:load": "bun scripts/qualification/acceptance-load.ts",
    "qualification:containers": "bun scripts/qualification/container-smoke.ts",
    "qualification:alerts": "docker run --rm --entrypoint /bin/promtool -v \"$PWD/docs/operations:/rules:ro\" -w /rules prom/prometheus:v3.5.0 test rules prometheus-rules.test.yml",
    "qualification:typecheck": "bunx tsc --noEmit -p scripts/qualification/tsconfig.json",
    "qualification:access": "NODE_ENV=test bun scripts/qualification/access-inventory.ts",
    "qualification:access:check": "NODE_ENV=test bun scripts/qualification/access-inventory.ts --check"
  },
  "devDependencies": {
    "@aws-sdk/client-sesv2": "^3.749.0",
    "@biomejs/biome": "^2.5.8",
    "@elysia/cors": "2.0.0-beta.1",
    "@elysia/openapi": "2.0.0-beta.1",
    "@sendgrid/mail": "^8.1.4",
    "@sinclair/typebox": "0.34.52",
    "@slack/web-api": "^7.8.0",
    "@types/bun": "latest",
    "@types/node": "^26.2.0",
    "bullmq": "^6.1.2",
    "drizzle-kit": "^1.0.0-rc.4",
    "drizzle-orm": "^1.0.0-rc.4",
    "elysia": "2.0.0-beta.6",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "twilio": "^5.4.3",
    "typebox": "^1.3.16",
    "typescript": "^7.0.2",
    "zod": "^4.4.3"
  },
  "packageManager": "bun@1.4.0"
}
